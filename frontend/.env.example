# URL base da API do backend. Para testar em dispositivo físico (Expo Go), use o IP local (ex: http://192.168.x.x:8080/api/v1).
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# UUID do único estabelecimento suportado (single-tenant).
# Deve bater com o UUID inserido na migration do backend:
#   backend/src/main/resources/db/migration/V1__seed_default_establishment.sql
EXPO_PUBLIC_ESTABLISHMENT_ID=11111111-1111-1111-1111-111111111111

